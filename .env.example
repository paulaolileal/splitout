# OAuth Client ID (type "Web application") from Google Cloud Console → APIs & Services → Credentials.
# Required. No client secret, no redirect URI — the app uses the client-side
# implicit OAuth2 flow (Google Identity Services), so this value is safe to
# expose in the built bundle.
VITE_GOOGLE_CLIENT_ID=

# There is no VITE_SPREADSHEET_ID: the spreadsheet id is resolved per user at
# runtime by the /setup flow (see src/store/spreadsheetStore.ts) and stored in
# the browser, never in an env var.
