# Base URL of the shared lealtek-api backend (Authorization Code + PKCE auth).
# Required. The OAuth Client ID/Secret live server-side in lealtek-api only —
# this app never talks to Google's OAuth endpoints directly anymore.
VITE_LEALTEK_API_URL=

# There is no VITE_SPREADSHEET_ID: the spreadsheet id is resolved per user at
# runtime by the /setup flow (see src/store/spreadsheetStore.ts) and stored in
# the browser, never in an env var.
